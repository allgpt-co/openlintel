# Public BUILD-TIME configuration. The generator does not automatically load dotenv.
# Export reviewed values into the build shell; rebuild docs/ after changes.
MARKETING_ORIGIN=https://openlintel.com
MARKETING_BASE_PATH=/
MARKETING_NOINDEX=false

# Leave these off until real account, delivery, ownership and privacy checks pass.
# No API secret belongs here or in generated HTML.
MARKETING_CONTACT_EMAIL=
MARKETING_FORMSPREE_ID=
MARKETING_FORMSPREE_VERIFIED=0
MARKETING_OPERATIONS_READY=0
MARKETING_PRIVACY_REVIEWED=0
MARKETING_PILOT_ENABLED=0
MARKETING_GA4_ID=
MARKETING_GA4_VERIFIED=0
MARKETING_ANALYTICS_ENABLED=0

# SERVER-SIDE read-only reporting configuration, separate from public measurement ID.
# Configure only actual, verified OpenLintel properties. Generic shared properties
# are intentionally ignored. Keep OAuth credentials outside this file/repository.
OPENLINTEL_GSC_SITE=
OPENLINTEL_GA4_PROPERTY_ID=
