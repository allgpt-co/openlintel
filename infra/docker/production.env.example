# Set these in Coolify; never commit actual values.
# A standalone PostgreSQL 16 database with pgvector installed, on DATABASE_NETWORK.
DATABASE_URL=
DATABASE_NETWORK=coolify
AUTH_URL=https://app.openlintel.com
NEXT_PUBLIC_COLLAB_SERVICE_URL=https://collab.openlintel.com
AUTH_SECRET=
JWT_SECRET=
API_KEY_ENCRYPTION_SECRET=
MEILI_MASTER_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Configure at least one complete OAuth provider pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Exact Git revision, also passed as build argument.
BUILD_SHA=
